{
  "name": "agentback",
  "version": "0.2.0",
  "description": "Collect feedback from AI agents inside your MCP server, CLI, or API and manage it in Agentback.",
  "license": "MIT",
  "homepage": "https://agentback.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superagents-lab/agentback-js.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "22.19.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/superagents-lab/agentback-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
